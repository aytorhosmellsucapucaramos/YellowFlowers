---
// IntroZoom.astro — Efecto túnel/warp 3D de flores al cargar la página
---

<div id="intro-overlay">
  <canvas id="intro-canvas"></canvas>
  <div class="intro-text">
    <span class="intro-date">21 de Septiembre</span>
    <span class="intro-title">Galaxia de Flores Amarillas</span>
  </div>
</div>

<style>
  #intro-overlay {
    position: fixed;
    inset: 0;
    background: #020208;
    z-index: 10000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.9s ease-out;
  }

  #intro-overlay.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  #intro-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .intro-text {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    animation: introTextFade 3s ease-in-out forwards;
  }

  .intro-date {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.85rem, 2.5vw, 1.1rem);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #FFD700bb;
  }

  .intro-title {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(2.2rem, 7vw, 4.5rem);
    color: #FFD700;
    text-shadow:
      0 0 20px #FFD70099,
      0 0 50px #FFD70055,
      0 0 90px #FFA00033;
  }

  @keyframes introTextFade {
    0%   { opacity: 0; transform: scale(0.85); }
    25%  { opacity: 1; transform: scale(1); }
    75%  { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.08); }
  }
</style>

<script>
(function initIntro() {
  const overlay = document.getElementById('intro-overlay') as HTMLDivElement;
  const canvas  = document.getElementById('intro-canvas')  as HTMLCanvasElement;
  if (!overlay || !canvas) return;

  const ctx = canvas.getContext('2d')!;

  function resize() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  const CX = () => canvas.width  / 2;
  const CY = () => canvas.height / 2;

  // ── Símbolos de flores para el túnel ──────────────────────────────────────
  const SYMBOLS = ['🌸', '🌼', '🌻', '✨', '💛', '🌟', '⭐'];

  interface WarpFlower {
    x: number;
    y: number;
    z: number;
    symbol: string;
    speed: number;
    angle: number;
    radius: number;
  }

  const TOTAL = 90;
  const flowers: WarpFlower[] = [];

  function spawnFlower(): WarpFlower {
    const angle  = Math.random() * Math.PI * 2;
    const radius = Math.random() * 60 + 5;
    return {
      x: Math.cos(angle) * radius,
      y: Math.sin(angle) * radius,
      z: Math.random() * 1.2,          // 0 = far, 1.2 = close
      symbol: SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)],
      speed: 0.006 + Math.random() * 0.012,
      angle,
      radius,
    };
  }

  for (let i = 0; i < TOTAL; i++) {
    const f = spawnFlower();
    f.z = Math.random() * 1.2;        // distribute over full depth
    flowers.push(f);
  }

  let startTime: number | null = null;
  const DURATION = 3000; // ms

  function draw(ts: number) {
    if (!startTime) startTime = ts;
    const elapsed = ts - startTime;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const cx = CX();
    const cy = CY();

    for (const f of flowers) {
      f.z += f.speed;
      if (f.z > 1.4) {
        Object.assign(f, spawnFlower(), { z: 0 });
      }

      // Perspective projection
      const perspective = 1 / (1.5 - f.z);
      const px = cx + f.x * perspective * Math.min(cx, cy) * 1.6;
      const py = cy + f.y * perspective * Math.min(cx, cy) * 1.6;

      const size    = Math.max(4, 8 + f.z * 36);
      const opacity = Math.min(1, f.z * 1.2);

      ctx.globalAlpha = opacity;
      ctx.font = `${size}px serif`;
      ctx.textAlign    = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(f.symbol, px, py);
    }

    ctx.globalAlpha = 1;

    // Motion-blur radial fade from center
    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.min(cx, cy) * 0.35);
    grad.addColorStop(0, '#020208cc');
    grad.addColorStop(1, '#02020800');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    if (elapsed < DURATION) {
      requestAnimationFrame(draw);
    } else {
      // Fade out intro overlay
      overlay.classList.add('fade-out');
      overlay.addEventListener('transitionend', () => {
        overlay.remove();
        window.dispatchEvent(new CustomEvent('intro-done'));
      }, { once: true });
    }
  }

  requestAnimationFrame(draw);
})();
</script>
