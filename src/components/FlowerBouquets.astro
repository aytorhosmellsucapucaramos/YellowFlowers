  data-base-x="28"
  data-base-y="78"
  role="button"
  tabindex="0"
  aria-label="Siempre juntos — click para abrir mensaje"
>
  <div class="bouquet-flowers">
    <span class="petal-ring ring3"></span>
    <span class="flower-emoji main">🌸</span>
    <span class="flower-emoji side a">🌼</span>
    <span class="flower-emoji side b">🌻</span>
