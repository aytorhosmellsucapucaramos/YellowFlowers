---
// FlowerBouquets.astro — Ramos de flores distribuidos con badges flotantes
// y detección de arrastre de la galaxia para actualizar su posición
---

<!-- Ramo 1 – "Eres mi sol ☀️" -->
<div
  class="bouquet"
  id="bouquet-1"
  data-modal="1"
  data-base-x="20"
  data-base-y="58"
  role="button"
  tabindex="0"
  aria-label="Eres mi sol — click para abrir mensaje"
>
  <div class="bouquet-flowers">
    <span class="petal-ring"></span>
    <span class="flower-emoji main">🌻</span>
    <span class="flower-emoji side a">🌼</span>
    <span class="flower-emoji side b">🌸</span>
    <span class="flower-emoji side c">🌼</span>
    <span class="sparkle-ring"></span>
  </div>
  <div class="badge">Eres mi sol ☀️</div>
</div>

